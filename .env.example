# Copy to .env for local development and replace placeholders with your own values.
DEEPSEEK_API_KEY=your_deepseek_api_key
GLM_API_KEY=your_glm_api_key

# Optional overrides; defaults are provided by app.py.
DEEPSEEK_API_URL=your_deepseek_api_url
DEEPSEEK_MODEL=your_deepseek_model
GLM_API_URL=your_glm_api_url
GLM_MODEL=your_glm_model

# Optional deployment settings
SECRET_KEY=replace_with_a_long_random_secret
DB_PATH=your_database_path
PORT=your_port
SEMESTER_START_DATE=YYYY-MM-DD
